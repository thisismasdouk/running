# The address the app will use, e.g. ai.pacebook.app (an A record pointing at this server).
DOMAIN=ai.example.com

# Your OpenAI API key. Use a key from a project with a monthly budget limit.
OPENAI_API_KEY=

# Signs the app's sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The iOS bundle ID; Apple sign-ins for any other app are refused.
APPLE_BUNDLE_ID=com.thisismasdouk.pacebook

# Photo estimates per user per day (resets at midnight UTC), and for everyone together.
DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=3000

# Models the app may ask for.
ALLOWED_MODELS=gpt-4o-mini
